{
  "display_information": { "name": "Codync", "description": "Talk to an assigned Codync bot" },
  "features": { "bot_user": { "display_name": "Codync", "always_online": false } },
  "oauth_config": { "scopes": { "bot": ["app_mentions:read", "chat:write", "channels:history", "groups:history", "im:history"] } },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-HOST.example/hooks/slack",
      "bot_events": ["app_mention", "message.channels", "message.groups", "message.im"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
