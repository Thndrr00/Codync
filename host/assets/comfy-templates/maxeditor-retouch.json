{
  "id": "maxeditor-retouch",
  "name": "Max Editor: retouch a passage",
  "version": "1.0.0",
  "description": "Tracks a subject in a clip, masks it and regenerates only that area with MiniMax H3, keeping the rest of the shot. Imported from Max Editor (Apache-2.0) with its own retouch graph.",
  "tags": [
    "video",
    "max-editor",
    "retouch",
    "needs-nodes",
    "higgsfield"
  ],
  "license": "Max Editor is Apache-2.0 (xentome) and needs its app’s node pack. Models: MiniMax H3 Community License, SAM License (Meta); the Pika Flex LoRA is a MiniMax H3 derivative.",
  "inputs": [
    {
      "key": "video",
      "label": "The clip to retouch",
      "type": "video",
      "required": true
    },
    {
      "key": "face",
      "label": "Reference frame of the subject",
      "type": "image",
      "required": true
    },
    {
      "key": "prompt",
      "label": "What should change in the masked area",
      "type": "text",
      "required": true
    },
    {
      "key": "width",
      "label": "Width",
      "type": "integer",
      "default": 1024,
      "min": 256,
      "max": 1920,
      "step": 16
    },
    {
      "key": "height",
      "label": "Height",
      "type": "integer",
      "default": 1024,
      "min": 256,
      "max": 1920,
      "step": 16
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed"
    }
  ],
