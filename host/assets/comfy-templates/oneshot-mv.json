  "output": {
    "type": "video",
    "mime": "video/mp4"
  },
  "estimate": {
    "seconds": 1800,
    "vram_gb": 24,
    "output_gb": 3,
    "byGpu": {
      "rtx-4090": {
        "seconds": 900,
        "vram_gb": 24
      },
      "default": {
        "seconds": 1800,
        "vram_gb": 24
      }
    }
  },
  "workflow": {
    "1": {
      "class_type": "LoadAudio",
      "inputs": {
        "audio": "{{song}}"
      }
    },
    "2": {
      "class_type": "FVDirector",
      "inputs": {
        "audio": [
          "1",
          0
        ],
        "world": "{{world}}",
        "world_images": "",
        "image_order": "in order",
        "image_fit": "crop",
        "cast": "crowd",
        "seconds": "{{seconds}}",
        "start": -1,
        "format": "{{format}}",
        "quality": "{{quality}}",
        "models": "{{models}}",
        "preview_only": false,
        "seed": "{{seed}}",
        "cuts_low": "every 2 bars",
        "cuts_medium": "every bar",
        "cuts_high": "to the music (subtle)",
        "audio_fx": "subtle",
        "crowd": "auto",
        "cast_order": "as written",
        "broll_share": 0.125,
        "qc_retries": 2,
        "run_name": "",
        "review_images": false
      }
    }
  }
}
