{
  "id": "oneshot-mv",
  "name": "OneShot MV: a song into a music video",
  "version": "1.0.0",
  "description": "Give a song and one line about its world: OneShot MV invents the cast, plans the cut by the song’s energy, renders and lip-syncs every shot and edits the video with the drums. Imported from VisualFrisson’s OneShot MV (MIT).",
  "tags": [
    "video",
    "higgsfield",
    "oneshot-mv",
    "music-video",
    "needs-nodes",
    "high-vram"
  ],
  "license": "OneShot MV is MIT (VisualFrisson) and needs its own node pack. Models: Krea 2 (Krea 2 Community License), LTX-2.3 and its LoRAs (LTX-2 Community License), Gemma text encoder, two community LoRAs.",
  "inputs": [
    {
      "key": "song",
      "label": "Song",
      "type": "audio",
      "required": true
    },
    {
      "key": "world",
      "label": "The world in a line or two",
      "type": "text",
      "required": true,
      "help": "Sets the people, their clothes, the places and the light, e.g. “a 1965 airline: pilots, stewardesses and passengers, warm cabin light”."
    },
    {
      "key": "seconds",
      "label": "Length (seconds, 0 = the whole song)",
      "type": "number",
      "default": 30,
      "min": 0,
      "max": 600,
      "step": 0.5
    },
    {
      "key": "format",
      "label": "Shape",
      "type": "select",
      "default": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1"
      ]
    },
    {
      "key": "quality",
      "label": "Quality",
      "type": "select",
      "default": "quality",
      "options": [
        "quality",
        "fast"
      ]
    },
    {
      "key": "models",
      "label": "Model set",
      "type": "select",
      "default": "auto",
      "options": [
        "auto",
        "24gb",
        "full"
      ]
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed"
    }
  ],
