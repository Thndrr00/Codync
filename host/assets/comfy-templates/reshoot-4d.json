  "workflow": {
    "1": {
      "class_type": "Sam3dbxCaptureSubject",
      "inputs": {
        "video": "{{source}}",
        "name": "",
        "start_time": 0,
        "end_time": 4,
        "mode": "4DGS splat (train)",
        "views": 24,
        "train_steps": 15000,
        "subject": "largest",
        "upload": "image",
        "trim_preview": ""
      }
    },
    "2": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": [
          1,
          3
        ],
        "frame_rate": 24,
        "loop_count": 0,
        "filename_prefix": "reshoot4d/trimmed",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": false,
        "videopreview": {
          "hidden": false,
          "paused": false,
          "params": {}
        }
      }
    },
    "3": {
      "class_type": "PreviewAny",
      "inputs": {
        "source": [
          1,
          2
        ]
      }
    },
    "4": {
      "class_type": "PreviewImage",
      "inputs": {
        "images": [
          1,
          1
        ]
      }
    },
    "5": {
