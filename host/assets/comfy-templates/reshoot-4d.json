{
  "id": "reshoot-4d",
  "name": "Reshoot 4D: reshoot from a new camera",
  "version": "1.0.0",
  "description": "Turns one clip into a 4D capture and reshoots it from a camera that never existed, then renders it photoreal. Imported from Reshoot 4D (AGPL-3.0); its published workflow was editor-only and is converted to API format.",
  "tags": [
    "video",
    "reshoot-4d",
    "camera",
    "needs-nodes",
    "higgsfield"
  ],
  "license": "Reshoot 4D is AGPL-3.0 (itsmetamike) and needs its pack, LTX 2.3 guides and a separate ReDirector environment. Models: LTX-2 Community License, Gemma terms, Apache-2.0 and MIT helpers; its RIFE weights ship with the Frame-Interpolation pack. The capture path is research-only: GVHMR terms, SMPL-X under non-commercial research terms with manual registration (body_models/smplx/SMPLX_NEUTRAL.npz), and the Turbo view LoRA under CC BY-NC-SA 4.0.",
  "inputs": [
    {
      "key": "source",
      "label": "The clip to reshoot",
      "type": "video",
      "required": true,
      "help": "One person, 2 to 8 seconds."
    },
    {
      "key": "prompt",
      "label": "What the shot should be",
      "type": "text",
      "required": false,
      "help": "Empty lets Qwen3-VL write it from the frames."
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed"
    }
  ],
