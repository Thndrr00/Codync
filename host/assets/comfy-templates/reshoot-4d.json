    },
    "30": {
      "class_type": "Sam3dbxRetakePhotoreal",
      "inputs": {
        "retake": [
          20,
          1
        ],
        "pass_type": "crossview",
        "seed": 11,
        "start_strength": 0.35,
        "control_strength": 0.6,
        "control_lora_strength": 0.7,
        "first_frame_strength": 0.9,
        "detailer": true,
        "crossview_start": 0.7
