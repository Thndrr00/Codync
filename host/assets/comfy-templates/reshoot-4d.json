      "inputs": {
        "images": [
          1,
          4
        ],
        "frame_rate": 24,
        "loop_count": 0,
        "filename_prefix": "reshoot4d/splat",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": false,
        "videopreview": {
          "hidden": false,
          "paused": false,
          "params": {}
        }
      }
    },
    "10": {
      "class_type": "Sam3dbxCameraDirector",
      "inputs": {
        "train_dir": [
          1,
          0
        ],
        "capture": "(no captures yet)",
        "mode": "4DGS (splat)",
        "director_state": "{\"duration\":4,\"fps\":24,\"shake\":0,\"bpm\":0,\"first_beat\":0,\"keys\":[],\"scene_mode\":\"auto\",\"speed\":1,\"scene_end\":\"hold\",\"path\":\"orbit\",\"shot_ease\":\"smooth\",\"follow\":false,\"space_dir\":\"\"}\n",
        "🎬 Open Virtual Camera": null,
