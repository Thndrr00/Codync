    "11": {
      "class_type": "PreviewAny",
      "inputs": {
        "source": [
          10,
          2
        ]
      }
    },
    "20": {
      "class_type": "Sam3dbxRetake",
      "inputs": {
        "train_dir": [
          10,
          0
        ],
        "camera_path": [
          10,
          1
        ],
        "resolution": "480p",
        "steps": 50,
        "seed": "{{seed}}",
        "prompt": "{{prompt}}",
        "cfg": 5
      }
    },
    "21": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": [
          20,
          0
        ],
        "frame_rate": [
          20,
          2
        ],
        "loop_count": 0,
