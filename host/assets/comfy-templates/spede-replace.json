{
  "id": "spede-replace",
  "name": "Splat Edit Engine: replace an object in a splat",
  "version": "1.0.0",
  "description": "Click an object in a Gaussian splat, say what should stand there, and the scene is rebuilt with a new one. Imported from Splat Edit Engine (AGPL-3.0) with its own local replace graph.",
  "tags": [
    "mesh",
    "spede",
    "splat",
    "replace",
    "needs-nodes",
    "higgsfield"
  ],
  "license": "Splat Edit Engine is AGPL-3.0 (Burgstall-labs) and needs its ComfyUI-SpEdE pack. Models: Qwen-Image 2.1 Research License (non-commercial), SAM License, TripoSplat MIT, DINOv3 License, FLUX.2 VAE Apache-2.0.",
  "inputs": [
    {
      "key": "scene",
      "label": "The scene (3DGS .ply)",
      "type": "file",
      "required": true
    },
    {
      "key": "cameras",
      "label": "Camera pack (.npz)",
      "type": "file",
      "required": true
    },
    {
      "key": "object",
      "label": "The object only (.ply)",
      "type": "file",
      "required": true,
      "help": "The cut-out object already in the scene, as the pack exports it."
    },
    {
      "key": "reference",
      "label": "Hero frame of the view",
      "type": "image",
      "required": true
    },
    {
      "key": "prompt",
      "label": "What takes its place",
      "type": "text",
      "required": true
    },
    {
      "key": "object_name",
      "label": "Name of the object",
      "type": "text",
      "required": true,
      "help": "Used for the cut-out and for SAM 3.1."
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed"
    }
  ],
