{
  "id": "freefield-angles",
  "name": "Angles (Freefield)",
  "version": "1.0.0",
  "description": "The same scene from another camera position: move, rotate, look down (Multiple Angles LoRA on Qwen-Image-Edit). Imported from Freefield (https://github.com/neuregex/freefield), MIT; its models keep their own licences.",
  "tags": [
    "higgsfield",
    "freefield",
    "image",
    "high-vram"
