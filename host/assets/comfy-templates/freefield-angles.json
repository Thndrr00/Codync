  "inputs": [
    {
      "key": "image",
      "label": "Your photo",
      "type": "image",
      "required": true,
      "help": "Up to 20 MB."
    },
    {
      "key": "move",
      "label": "Camera move",
      "type": "select",
      "required": false,
      "options": [
        "将镜头向前移动 Move the camera forward.",
        "将镜头向后移动 Move the camera backward.",
        "将镜头向左移动 Move the camera left.",
        "将镜头向右移动 Move the camera right.",
        "将镜头向上移动 Move the camera up.",
        "将镜头向下移动 Move the camera down.",
        "将镜头向左旋转45度 Rotate the camera 45 degrees to the left.",
        "将镜头向右旋转45度 Rotate the camera 45 degrees to the right.",
        "将镜头转为俯视 Turn the camera to a top-down view.",
        "将镜头转为仰视 Turn the camera to a low-angle view looking up."
      ],
      "default": "将镜头向左旋转45度 Rotate the camera 45 degrees to the left."
    },
    {
      "key": "details",
      "label": "Extra direction",
      "type": "text",
      "required": false,
      "default": "",
      "help": "Added at the end of the app's prompt."
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "required": false,
      "help": "-1 picks a random seed"
    }
  ],
