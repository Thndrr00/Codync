    },
    "110": {
      "inputs": {
        "source_frames": [
          "31",
          5
        ],
        "expansion_px": "{{expand}}",
        "masks": [
          "107",
          0
        ],
        "images": [
          "31",
          0
        ]
      },
      "class_type": "H3CharacterSwapExpandMask",
      "_meta": {
        "title": "Expand mask · matches the app"
      }
    },
    "800": {
      "inputs": {
        "model": [
          "850",
          0
        ],
        "clip": [
          "58",
          0
