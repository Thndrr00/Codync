          "31",
          5
        ],
        "fps": [
          "31",
          6
        ],
        "use_anchor": "{{anchor}}",
        "use_mask": "{{mask}}",
        "shot_id": "character-swap",
        "source_video": [
          "trim",
          0
        ],
        "source": [
          "31",
          0
        ],
        "source_audio": [
          "31",
          1
        ],
        "reference": [
          "9",
          0
        ],
        "anchor": [
          "anchor_fit",
          0
        ],
        "body_mask": [
          "110",
          0
        ]
      },
      "class_type": "H3CharacterSwapShot",
