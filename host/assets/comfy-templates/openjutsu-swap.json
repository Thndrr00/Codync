{
  "id": "openjutsu-swap",
  "name": "Swap the person in a clip",
  "version": "1.0.0",
  "description": "Give a performance clip and one picture of a character: the person in the clip is replaced by the character while the scene, the performance and the sound stay. Imported from Genobi’s copy of Comfy Openjutsu (MIT) and Akatz Labs’ H3 Character Swap (MIT).",
  "tags": [
    "video",
    "higgsfield",
    "genobi",
    "character-swap",
    "needs-nodes"
  ],
  "license": "Comfy Openjutsu and Akatz Labs’ H3 Character Swap are MIT (Genobi, MIT). The graph needs Akatz Labs’ h3_character_swap pack (GPL-3.0), which needs its GPL patch to the pack. Models: MiniMax H3, Akatz LoRA (MiniMax H3 Community License), SAM 3.1 (SAM License), lightx2v Turbo (Apache-2.0).",
  "inputs": [
    {
      "key": "source",
      "label": "Performance clip",
      "type": "video",
      "required": true,
      "help": "Five to fifteen seconds of one person."
    },
    {
      "key": "character",
      "label": "Character picture",
      "type": "image",
      "required": true
    },
    {
      "key": "prompt",
      "label": "What to keep",
      "type": "text",
      "required": true,
      "default": "Replace the selected person with the reference character. Preserve source performance, scene and audio timing."
    },
    {
      "key": "start",
      "label": "Start at (seconds)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 600,
      "step": 0.1
    },
    {
      "key": "duration",
      "label": "Length (seconds)",
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 15,
      "step": 0.5
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 30
    },
    {
      "key": "memory",
      "label": "Activation memory (GiB)",
      "type": "integer",
      "default": 17,
      "min": 8,
      "max": 64
    },
    {
      "key": "expand",
      "label": "Grow the body mask (px)",
      "type": "integer",
      "default": 64,
      "min": 0,
      "max": 160
    },
    {
      "key": "anchor",
      "label": "Keep the reference framing",
      "type": "boolean",
      "default": true
    },
    {
      "key": "mask",
      "label": "Keep only the tracked body",
      "type": "boolean",
      "default": true
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed"
    }
  ],
  "models": [
    {
      "file": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "folder": "diffusion_models",
      "size": 20970379616,
