        "title": "Prepare swap inputs"
      }
    },
    "805": {
      "inputs": {
        "window_frames": "124",
        "history_frames": "18",
        "shot": [
          "803",
          0
        ],
        "settings": [
          "801",
          0
        ]
      },
      "class_type": "H3CharacterSwapWindowPlan",
      "_meta": {
        "title": "Continuation · window / history"
      }
    },
    "806": {
      "inputs": {
        "models": [
          "800",
          0
        ],
        "shot": [
          "803",
          0
        ],
        "plan": [
          "805",
          0
        ]
      },
      "class_type": "H3CharacterSwapController",
