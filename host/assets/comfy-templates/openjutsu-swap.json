      "class_type": "UNETLoader",
      "_meta": {
        "title": "H3 Ref2VA · INT8"
      }
    },
    "2": {
      "inputs": {
        "shift_video": 12,
        "shift_audio": 3,
        "model": [
          "1",
          0
        ]
      },
      "class_type": "MiniMaxH3SigmaShift",
      "_meta": {
        "title": "H3 sampling shift"
      }
    },
    "3": {
      "inputs": {
        "attention": "comfy kitchen attention",
        "model": [
          "2",
          0
        ]
      },
      "class_type": "ModelAttentionBackend",
      "_meta": {
        "title": "Optimized attention"
      }
    },
    "4": {
      "inputs": {
        "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_768p_comfyui_bf16.safetensors",
        "strength_model": 1,
        "model": [
          "3",
          0
        ]
      },
      "class_type": "LoraLoaderModelOnly",
      "_meta": {
        "title": "FL2V Turbo · 8-step LoRA"
      }
    },
    "6": {
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "Qwen · H3 text encoder"
      }
    },
    "7": {
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "H3 video VAE"
      }
    },
    "8": {
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "H3 audio VAE"
      }
    },
    "9": {
      "inputs": {
        "image": "{{character}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "2 · Character reference"
      }
    },
    "30": {
      "inputs": {
        "file": "{{source}}"
      },
      "class_type": "LoadVideo",
      "_meta": {
        "title": "1 · Source performance video"
      }
    },
    "31": {
      "inputs": {
        "resolution": 768,
        "duration_seconds": "{{duration}}",
        "video": [
          "trim",
          0
        ]
      },
      "class_type": "H3CharacterSwapPrepareVideo",
      "_meta": {
        "title": "Prepare · 24 fps / pixel budget"
      }
    },
    "58": {
      "inputs": {
        "device": "gpu:0",
        "clip": [
          "6",
          0
        ]
      },
      "class_type": "SelectCLIPDevice",
      "_meta": {
        "title": "Text encoder device"
      }
    },
    "100": {
      "inputs": {
        "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "SAM 3.1 · model"
      }
    },
    "101": {
      "inputs": {
        "text": "person",
        "clip": [
          "100",
          1
        ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "4 · Find the subject"
      }
    },
    "102": {
      "inputs": {
        "batch_index": 0,
        "length": 1,
        "image": [
          "31",
          0
        ]
      },
      "class_type": "ImageFromBatch",
      "_meta": {
        "title": "Detection frame · first frame"
      }
    },
    "103": {
      "inputs": {
        "threshold": 0.35,
        "refine_iterations": 2,
        "individual_masks": true,
        "model": [
          "100",
          0
        ],
        "image": [
          "102",
          0
        ],
        "conditioning": [
          "101",
          0
        ]
      },
      "class_type": "SAM3_Detect",
      "_meta": {
        "title": "Detect individual people"
      }
    },
    "104": {
      "inputs": {
        "selection": "largest",
        "index": 0,
        "masks": [
          "103",
          0
        ]
      },
      "class_type": "H3CharacterSwapSelectSubject",
      "_meta": {
        "title": "Select the person to replace"
      }
    },
    "105": {
      "inputs": {
        "detection_threshold": 0.5,
        "max_objects": 1,
        "detect_interval": 1,
        "images": [
          "31",
          0
        ],
        "model": [
          "100",
          0
        ],
        "initial_mask": [
          "104",
          0
        ],
        "conditioning": [
          "101",
          0
        ]
      },
      "class_type": "SAM3_VideoTrack",
      "_meta": {
        "title": "Track selected person"
      }
    },
    "106": {
      "inputs": {
        "object_indices": "",
        "track_data": [
          "105",
          0
        ]
      },
      "class_type": "SAM3_TrackToMask",
      "_meta": {
        "title": "Selected track → mask"
      }
    },
    "107": {
      "inputs": {
        "source_frames": [
          "31",
          5
        ],
        "recover_empty_frames": true,
        "masks": [
          "106",
          0
        ],
        "images": [
          "31",
          0
        ],
        "model": [
          "100",
          0
        ],
        "conditioning": [
          "101",
          0
        ],
        "selection": [
          "104",
          1
        ]
      },
      "class_type": "H3CharacterSwapRecoverMasks",
