{
  "id": "text-to-image",
  "name": "Text to image",
  "version": "1.0.0",
  "description": "A picture from a description with Stable Diffusion 1.5: the everyday graph, with the size, the steps and the seed as fields.",
  "tags": ["image", "stable-diffusion", "starter"],
  "license": "The graph is Codync's; the checkpoint keeps its own licence (CreativeML OpenRAIL-M).",
  "inputs": [
    {
      "key": "prompt",
      "label": "What to draw",
      "type": "text",
      "required": true,
      "help": "The subject, the style and the light, in one or two sentences."
    },
    {
      "key": "negative",
      "label": "What to avoid",
      "type": "text",
      "default": "blurry, low quality, watermark, text"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "integer",
      "default": 512,
      "min": 256,
      "max": 1536,
      "step": 64
    },
    {
      "key": "height",
      "label": "Height",
      "type": "integer",
      "default": 512,
      "min": 256,
      "max": 1536,
      "step": 64
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "integer",
      "default": 20,
      "min": 1,
      "max": 60
    },
    {
      "key": "sampler",
      "label": "Sampler",
      "type": "select",
      "options": ["euler", "euler_ancestral", "dpmpp_2m", "dpmpp_2m_sde"],
      "default": "euler"
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "help": "The same seed and prompt give the same picture."
    }
  ],
  "models": [
    {
      "file": "v1-5-pruned-emaonly-fp16.safetensors",
      "folder": "checkpoints",
      "size": 2132696762,
      "url": "https://huggingface.co/Comfy-Org/stable-diffusion-1.5/resolve/main/v1-5-pruned-emaonly-fp16.safetensors",
      "license": "CreativeML OpenRAIL-M"
    }
  ],
  "output": {"type": "image", "mime": "image/png"},
  "estimate": {
    "seconds": 12,
    "vram_gb": 4.0,
    "output_gb": 0.1,
    "byGpu": {
      "rtx-4090": {"seconds": 3, "vram_gb": 4.0},
      "rtx-3060": {"seconds": 11, "vram_gb": 4.0},
      "default": {"seconds": 14, "vram_gb": 4.0}
    }
  },
  "workflow": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {"ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors"}
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "{{prompt}}", "clip": ["1", 1]}
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "{{negative}}", "clip": ["1", 1]}
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": 7.5,
        "sampler_name": "{{sampler}}",
        "scheduler": "normal",
        "denoise": 1.0,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["5", 0], "vae": ["1", 2]}
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {"images": ["6", 0], "filename_prefix": "codync/t2i"}
    }
  }
}
