    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    },
    "5": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "{{source}}"
      }
    },
    "6": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "{{mask}}"
      }
    },
    "8": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "7",
          0
        ]
      }
    },
    "9": {
      "class_type": "ImageToMask",
      "inputs": {
        "image": [
          "8",
          0
        ],
        "channel": "red"
      }
    },
    "10": {
      "class_type": "ThresholdMask",
      "inputs": {
        "mask": [
          "9",
          0
        ],
        "value": 0.5
      }
    },
    "13": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "30",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "14": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "audio_vae": [
          "4",
          0
        ],
        "prompt": "{{prompt}}",
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{length}}",
        "ref_image_size": "match"
      }
    },
    "15": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "14",
          1
        ]
      }
    },
    "16": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "13",
          0
        ],
        "audio_latent": [
          "15",
          1
        ]
      }
    },
    "17": {
      "class_type": "vloMaskToLatentMask",
      "inputs": {
        "latent": [
          "16",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "masks": [
          "33",
          0
        ],
        "pooling_method": "max",
        "resize_mode": "max",
        "snap_grid": 1
      }
    },
    "18": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "16",
          0
        ],
        "mask": [
          "17",
          0
        ]
      }
    },
    "19": {
      "class_type": "ModelAttentionBackend",
      "inputs": {
        "model": [
          "36",
          0
        ],
        "attention": "comfy kitchen attention"
      }
    },
    "20": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "35",
          0
        ],
        "conditioning": [
          "14",
          0
        ]
      }
    },
    "21": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "1.0, 0.972973, 0.923077, 0.8, 0.571429, 0.333333, 0.0"
      }
    },
    "22": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "lcm"
      }
    },
    "23": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{{seed}}"
      }
    },
    "24": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "23",
          0
        ],
        "guider": [
          "20",
          0
        ],
        "sampler": [
          "22",
          0
        ],
        "sigmas": [
          "21",
          0
        ],
        "latent_image": [
          "18",
          0
        ]
      }
    },
    "25": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "24",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "26": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "24",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "27": {
