{
  "id": "h3-motion-mask",
  "name": "H3 Motion: change what happens in a mask",
  "version": "1.0.0",
  "description": "Draw a moving mask over a clip and H3 regenerates only what is inside it, keeping the rest of the shot and its sound. Imported from PxTicks’ H3 Motion (AGPL-3.0) with its own inpaint graph and models.",
  "tags": [
    "video",
    "higgsfield",
    "h3-motion",
    "inpaint",
    "mask",
    "needs-nodes"
  ],
  "license": "H3 Motion is AGPL-3.0 (PxTicks) and needs its ComfyUI-vlo node pack. Models: MiniMax H3 Community License, plus VideoHelperSuite for LoadVideo.",
  "inputs": [
    {
      "key": "source",
      "label": "The clip to change",
      "type": "video",
      "required": true
    },
    {
      "key": "mask",
      "label": "Mask clip, one frame per source frame",
      "type": "video",
      "required": true,
      "help": "White where the shot changes, black everywhere else; same length as the clip."
    },
    {
      "key": "prompt",
      "label": "What happens inside the mask",
      "type": "text",
      "required": true
    },
    {
      "key": "length",
      "label": "Frames",
      "type": "integer",
      "default": 124,
      "min": 32,
      "max": 480
    },
    {
      "key": "width",
      "label": "Width",
      "type": "integer",
      "default": 864,
      "min": 256,
      "max": 1920,
      "step": 16
    },
    {
      "key": "height",
      "label": "Height",
      "type": "integer",
      "default": 480,
      "min": 256,
      "max": 1088,
      "step": 16
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed"
    }
  ],
  "models": [
    {
      "file": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "folder": "diffusion_models",
      "size": 20970379616,
      "sha256": "9255f52b6677845ad238f20dfaafa94727053694127ab7f255c048f0f9365779",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "license": "MiniMax H3 Community License"
    },
    {
      "file": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "folder": "text_encoders",
      "size": 15687142551,
      "sha256": "35a88d51044231fe332301d7a62aa81e3f2cba62febeb446e2c1e3e0ef76f2c6",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "license": "MiniMax H3 Community License"
    },
    {
      "file": "minimax_h3_video_vae_int8_convrot.safetensors",
      "folder": "vae",
      "size": 2811065184,
      "sha256": "52a2c8c73583c86e4f41cdcce3a6ad0ea562987bc0bf3d60a0cef5f5c8e60c0e",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "license": "MiniMax H3 Community License"
    },
    {
      "file": "minimax_h3_audio_vae_fp32.safetensors",
      "folder": "vae",
      "size": 605254808,
      "sha256": "8e505d95dd1561d47abd43d4238fd40d9bb1ae9e147ed0a4cba778d76ae4db48",
      "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_audio_vae_fp32.safetensors",
      "license": "MiniMax H3 Community License"
    },
    {
      "file": "pika_h3_flex_ref2va_v1_bf16.safetensors",
      "folder": "loras",
      "size": 1956172304,
      "sha256": "de3745ceb7d8d5c20898dd8fa3a05f1c0b00089ccd55297b2a8bab95c766b0e0",
