    "36": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "pika_h3_flex_ref2va_v1_bf16.safetensors",
        "strength_model": 1
      }
    }
  }
}
