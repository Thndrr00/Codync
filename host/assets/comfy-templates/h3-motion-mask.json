    },
    "29": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "28",
          0
        ],
        "filename_prefix": "h3m/inpaint",
        "format": "mp4",
        "format.codec": "h264",
        "format.codec.encoding": "auto"
      }
    },
    "30": {
      "class_type": "ImageScale",
      "inputs": {
