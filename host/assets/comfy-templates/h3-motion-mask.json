          "34",
          0
        ],
        "mask": [
          "10",
          0
        ],
        "x": 0,
        "y": 0,
        "resize_source": false
      }
    },
    "28": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "27",
          0
        ],
