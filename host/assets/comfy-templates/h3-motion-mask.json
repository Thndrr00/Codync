      "license": "MiniMax H3 Community License"
    }
  ],
  "output": {
    "type": "video",
    "mime": "video/mp4"
  },
  "estimate": {
    "seconds": 240,
    "vram_gb": 24,
    "output_gb": 1.5,
    "byGpu": {
      "rtx-4090": {
        "seconds": 90,
        "vram_gb": 24
      },
      "default": {
        "seconds": 240,
        "vram_gb": 24
      }
    }
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
